<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Developer ID builds use Hardened Runtime and library validation.
         whisper.framework is signed with the same Apple team as the app.
         Global keyboard access needs Accessibility permission, not App Sandbox.
         Microphone access also needs the user's TCC permission. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
